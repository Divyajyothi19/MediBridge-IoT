# Backend secrets (FastAPI server). Copy to .env, never commit .env.
# The SAME Blynk device token is also in the firmware's circuit/config.h.
# The React frontend must NEVER receive this value.
BLYNK_AUTH_TOKEN=PASTE_YOUR_DEVICE_AUTH_TOKEN_HERE
BLYNK_BASE_URL=https://blynk.cloud
POLL_INTERVAL_SECONDS=1
GMAIL_SMTP_USER=PASTE_GMAIL_ADDRESS
GMAIL_APP_PASSWORD=PASTE_GOOGLE_APP_PASSWORD
CAREGIVER_EMAIL=PASTE_CAREGIVER_EMAIL
DATABASE_URL=sqlite:///./medibridge.db
